[Unit]
Description=Initialize AMP 3 data as the unprivileged service account
After=network.target

[Service]
Type=oneshot
User=amp
Group=amp
UMask=0027
EnvironmentFile=/etc/amp3-docker.env
ExecStart=/opt/entrypoint/amp3-bootstrap.sh
RemainAfterExit=yes
TimeoutStartSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
